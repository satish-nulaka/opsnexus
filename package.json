{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "Production REST API for TaskFlow - SIT223/SIT753 DevOps Pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --ci --coverage --testResultsProcessor=jest-junit",
    "test:unit": "jest tests/unit --ci --coverage",
    "test:integration": "jest tests/integration --ci --runInBand",
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "security:audit": "npm audit --audit-level=moderate || true",
    "build": "echo 'Building TaskFlow API package...' && node -e \"console.log('Build completed successfully. Version: ' + require('./package.json').version)\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "jest-junit": {
    "outputDirectory": "test-results",
    "outputName": "junit.xml"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
